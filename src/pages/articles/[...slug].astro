---
import { getCollection } from 'astro:content';
import ArticleReader from '../../components/ArticleReader.astro';
export async function getStaticPaths() {
  return (await getCollection('posts', ({data}) => !data.draft && data.seriesRole !== 'overview')).map(post=>({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
---
<ArticleReader post={post}/>
