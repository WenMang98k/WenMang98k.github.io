---
import Base from '../../layouts/Base.astro';
import { articles, formatDate } from '../../data/site';
const posts = await articles();
const tags = [...new Set(posts.flatMap(p=>p.tags))];
---
<Base title="文章 · WenMang"><section class="page-heading"><p class="eyebrow">NOTES / IDEAS / ENGINEERING</p><h1>边实践，边记录<span>。</span></h1><p class="lead">模型、系统与工程之间，一些值得留下的思考。</p></section><section aria-label="搜索技术文章"><div class="search-bar"><label for="search">搜索文章</label><input id="search" type="search" placeholder="标题、摘要或标签…"/></div><div class="filters" role="group" aria-label="按标签筛选"><button type="button" data-tag="" aria-pressed="true">全部</button>{tags.map(tag=><button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}</div><p class="meta" id="results" aria-live="polite">共 {posts.length} 篇文章</p><div class="article-list">{posts.map((post,i)=><a class="article-row" href={post.href} data-post data-tags={JSON.stringify(post.tags)} data-search={[post.title, post.description, ...post.tags].join(' ').toLocaleLowerCase()}><span class="row-num">0{i+1}</span><div><div class="meta">{formatDate(post.date)} · {post.tags.join(' / ')}</div><h2>{post.title}</h2><p>{post.description}</p></div><span class="arrow">↗</span></a>)}</div><p id="empty" hidden>没有找到匹配的文章，试试其他关键词。</p></section></Base>
<script>
const search = document.querySelector<HTMLInputElement>('#search')!;
const buttons = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
let tag = '';
function filter() {
  let count = 0;
  document.querySelectorAll<HTMLAnchorElement>('[data-post]').forEach(row => {
    const matches = (!tag || JSON.parse(row.dataset.tags!).includes(tag)) && row.dataset.search!.includes(search.value.trim().toLocaleLowerCase());
    row.hidden = !matches; if (matches) count++;
  });
  document.querySelector('#results')!.textContent = `共 ${count} 篇文章`;
  (document.querySelector('#empty') as HTMLElement).hidden = count > 0;
}
search.addEventListener('input', filter);
buttons.forEach(button => button.addEventListener('click', () => {
  tag = button.dataset.tag!;
  buttons.forEach(b=>b.setAttribute('aria-pressed', String(b === button)));
  filter();
}));
</script>
